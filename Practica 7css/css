/* GOOGLE FONTS */

@import url('https://fonts.googleapis.com/css2?family=Fredoka:wght@400;600&family=Open+Sans&display=swap');

/* COLORES */

:root {

    --fondo: #fef6e4;

    --texto: #001858;

    --acento: #f582ae;

}

/* BODY */

body {

    margin: 0;

    font-family: 'Open Sans', sans-serif;

    background-color: var(--fondo);

    color: var(--texto);

}

/* HEADER */

header {

    background-color: var(--acento);

    padding: 15px;

    position: sticky;

    top: 0;

}

/* TITULOS */

h1, h2, h3 {

    font-family: 'Fredoka', sans-serif;

}

/* NAV FLEXBOX */

nav {

    display: flex;

    justify-content: center;

    gap: 20px;

}

nav a {

    color: white;

    text-decoration: none;

    font-weight: bold;

}

/* HOVER */

nav a:hover {

    color: var(--texto);

}

/* MAIN */

main {

    max-width: 900px;

    margin: auto;

}

/* SECCIONES */

section {

    background-color: white;

    margin: 20px;

    padding: 20px;

    border-radius: 10px;

}

/* FLOAT IMAGEN */

.img-historia {

    float: left;

    margin-right: 15px;

    width: 200px;

    border-radius: 10px;

}

/* TABLA */

table {

    width: 100%;

    border-collapse: collapse;

}

th {

    background-color: var(--acento);

    color: white;

}

td, th {

    border: 2px solid var(--texto);

    padding: 10px;

}

/* FORM */

input {

    padding: 8px;

}

/* BOTÓN */

input[type="submit"] {

    background-color: var(--acento);

    color: white;

    border: none;

    cursor: pointer;

}

input[type="submit"]:hover {

    background-color: #ff8fab;

}

/* GALERÍA FLEXBOX */

#galeria {

    display: flex;

    flex-wrap: wrap;

    justify-content: center;

    gap: 10px;

}

.galeria-img {

    width: 150px;

    border-radius: 10px;

}

/* FOOTER */

footer {

    background-color: var(--acento);

    color: white;

    text-align: center;

    padding: 10px;

}
 